# ===================================================
# Lumina Grid LK - Solar Generation Data API
# Environment Configuration Template
# ===================================================

# Server Runtime
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1

# Database Configuration (Neon PostgreSQL)
DATABASE_URL=postgresql://neondb_owner:password@ep-example-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://neondb_owner:password@ep-example.us-east-2.aws.neon.tech/neondb?sslmode=require

# Security & JWT Authentication
JWT_SECRET=super-secret-jwt-key-minimum-32-characters-for-slsea-security!
